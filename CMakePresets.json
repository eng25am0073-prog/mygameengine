{
  "version": 6,
  "configurePresets": [
    {
      "name": "ninja-msvc",
      "displayName": "Ninja + MSVC (run from a VS Developer PowerShell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
      }
    },
    {
      "name": "vs-msvc",
      "displayName": "Visual Studio 2022 (works from any terminal)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs"
    }
  ]
}